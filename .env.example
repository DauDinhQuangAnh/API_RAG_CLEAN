GEMINI_API_KEY=replace_with_your_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_RERANKER_MODEL=gemini-2.5-flash-lite
CHROMA_DB_PATH=db
CHROMA_DB_PATH_LOCAL=db

# Embedding chỉ dùng local SBERT cho tiếng Việt
# Model: keepitreal/vietnamese-sbert (tối ưu cho tiếng Việt)
RAG_LOCAL_EMBEDDING_MODEL=keepitreal/vietnamese-sbert

RAG_INITIAL_TOP_K=20
RAG_FINAL_TOP_N=6
RAG_CHUNKING_PROFILE=hybrid
RAG_INCLUDE_NEIGHBORS=true

# Reranker: llm | crossencoder | none
RAG_RERANKER_TYPE=llm
# Cross-encoder cho tiếng Việt (dùng khi RAG_RERANKER_TYPE=crossencoder)
RAG_CROSS_ENCODER_MODEL=itdainb/PhoRanker

RAG_MAX_CONTEXT_EXPANSION_PER_CANDIDATE=3
RAG_MAX_TOTAL_CANDIDATES=40
RAG_ENABLE_DISTANCE_GUARD=false
RAG_MAX_CONCURRENT_QUERIES=8
RAG_MAX_CONCURRENT_LLM_CALLS=3
RAG_QUERY_QUEUE_TIMEOUT_SECONDS=2
RAG_LLM_QUEUE_TIMEOUT_SECONDS=10
RAG_ENABLE_FINAL_ANSWER_FALLBACK=true

# CORS: production cần đặt domain cụ thể, KHÔNG dùng * trên production.
# Mặc định chỉ cho phép localhost khi không set.
RAG_CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Debug: khi true, response query sẽ trả thêm full_prompt (chỉ dùng khi dev).
RAG_DEBUG_MODE=false

# Embedding cache: số lượng vector lưu trong bộ nhớ (LRU). 0 = tắt cache.
RAG_EMBEDDING_CACHE_SIZE=1000

# Optional: khi set, các endpoint được bảo vệ yêu cầu header X-Internal-API-Key
# RAG_INTERNAL_API_KEY=replace_with_internal_secret
